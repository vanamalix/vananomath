{
  "name": "math",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "math.vananomad.com: famous proofs explained step by step, starting with the 2026 Lean proof of the Riemann Hypothesis. Prerendered static pages on Cloudflare Workers.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8798",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run budget && npm run test",
    "budget": "vn-js-budget dist 200",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@vanamalix/ui": "0.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanamalix/config": "0.2.1",
    "@vanamalix/governance": "0.5.0",
    "@vanamalix/testing": "0.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "katex": "0.19.1",
    "typescript": "~5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
